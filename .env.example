# ==============================================================================
# PakSeekers — Environment Configuration Template
#
# Copy this file to .env or .env.local and populate with your credentials.
# NEVER commit .env, .env.local, or any file containing real credentials to git.
# ==============================================================================

# MongoDB Atlas Connection String
# Standard SRV format:
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/pakseekers?retryWrites=true&w=majority"
DATABASE_URL="mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/pakseekers?retryWrites=true&w=majority"

# Target Database Selection:
# - Production: 'pakseekers'
# - Preview / Development: 'pakseekers_preview'
MONGODB_DB="pakseekers"

# Private Admin Portal Entry Route
ADMIN_ENTRY_PATH="/admin-gate"

# Email Verification & SMTP (Nodemailer / Gmail)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-gmail-app-password"
SMTP_FROM="PakSeekers <your-email@gmail.com>"

# Application Base URL for Verification Links
APP_URL="https://pakseekers.vercel.app"

# Node Environment ('development' | 'test' | 'production')
NODE_ENV="development"
